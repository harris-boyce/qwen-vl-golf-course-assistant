# Environment variables for the Golf Course Assistant
# Copy this file to .env and fill in your credentials

# USGS API credentials (for NAIP imagery access)
USGS_API_KEY=your_usgs_api_key_here

# HuggingFace token (for downloading Qwen-VL model)
HF_TOKEN=your_huggingface_token_here

# Optional: Specific model configuration
MODEL_NAME=Qwen/Qwen-VL-Chat
DEVICE=auto

# Optional: Output configuration
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
